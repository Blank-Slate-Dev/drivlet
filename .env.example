# ──────────────────────────────────────────────────────────────────────────────
# Drivlet — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/drivlet

# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://drivlet.com.au

# Stripe — Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe — Webhook Signing Secrets (one per endpoint registered in Stripe Dashboard)
# Endpoints to register:
#   /api/stripe/webhook                  → STRIPE_WEBHOOK_SECRET
#   /api/stripe/request-payment-webhook  → STRIPE_REQUEST_WEBHOOK_SECRET  (CRITICAL: paid requests never become bookings without it)
#   /api/stripe/service-payment-webhook  → STRIPE_SERVICE_PAYMENT_WEBHOOK_SECRET
#   /api/stripe/subscription-webhook     → STRIPE_SUBSCRIPTION_WEBHOOK_SECRET (only when garage subscriptions launch)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_REQUEST_WEBHOOK_SECRET=whsec_...
STRIPE_SERVICE_PAYMENT_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...

# Stripe — Test-charge override. NEVER set these in any Vercel environment.
# STRIPE_TEST_MODE=true charges $1 instead of the real price (local dev only).
# On Vercel it is ignored unless STRIPE_TEST_MODE_ALLOW_PRODUCTION=true is also set.
# STRIPE_TEST_MODE=
# STRIPE_TEST_MODE_ALLOW_PRODUCTION=

# Stripe — Garage Subscription Price IDs
STRIPE_ANALYTICS_MONTHLY_PRICE_ID=price_...
STRIPE_ANALYTICS_YEARLY_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...

# Mailjet — Email (sender must be verified in Mailjet, SPF/DKIM on the domain)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
EMAIL_FROM=noreply@drivlet.com.au
# Where admin notifications are sent (defaults to support@drivlet.com.au)
ADMIN_NOTIFICATION_EMAIL=support@drivlet.com.au
# Comma-separated admin emails allowed to view analytics (defaults to support@)
ANALYTICS_ADMIN_EMAILS=support@drivlet.com.au

# Twilio — SMS & Voice
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+61xxxxxxxxx

# App URL (used in emails and webhooks — no trailing slash)
APP_URL=https://drivlet.com.au
NEXT_PUBLIC_APP_URL=https://drivlet.com.au

# AutoGrab — Vehicle Registration Lookup
AUTOGRAB_API_KEY=your-autograb-api-key

# Cron job authentication
CRON_SECRET=your-cron-secret-token

# Google Maps / Places
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Google Analytics (build-time; GA silently absent if unset)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Blob storage. Auto-injected when the Blob store is connected to the
# Vercel project — only set manually for local dev. All photo/document
# uploads fail without it.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Feature Flags (set to 'true' to enable — leave unset or 'false' for Phase 1)
NEXT_PUBLIC_ENABLE_SERVICE_SELECTION=false
NEXT_PUBLIC_ENABLE_QUOTE_SYSTEM=false
NEXT_PUBLIC_ENABLE_GARAGE_ASSIGNMENT=false
NEXT_PUBLIC_ENABLE_GARAGE_QUOTES=false
# Whole garage portal (pages + every /api/garage route). MUST stay off until
# the MUST-FIX-BEFORE-PHASE-2 list in src/lib/garagePortal.ts is cleared.
NEXT_PUBLIC_ENABLE_GARAGE_PORTAL=false
